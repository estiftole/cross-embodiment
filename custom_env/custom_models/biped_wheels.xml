<mujoco model="purple_wheeled_balancer">
  <default>
    <geom rgba="0.67 0.5 0.7 1" density="1000"/>
    <joint damping="0.5" armature="0.01" stiffness="0" limited="true"/>
    <motor gear="20"/>
  </default>

  <worldbody>
    <body name="torso" pos="0 0 2">
      <freejoint/>
      <geom name="torso_box" type="box" size="0.08 0.18 0.3"/>

      <geom name="pelvis_sphere" type="sphere" size="0.06" pos="0 0 -0.36"/>
      <geom name="pelvis_cyl_left" type="cylinder" fromto="0 0.05 -0.36  0 0.12 -0.36" size="0.035"/>
      <geom name="pelvis_cyl_right" type="cylinder" fromto="0 -0.05 -0.36  0 -0.12 -0.36" size="0.035"/>

      <body name="left_leg" pos="0 0.12 -0.36">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-50 50"/>
        <geom name="left_thigh" type="cylinder" fromto="0 0 0  0 0 -0.3" size="0.03"/>
        <body name="left_shin" pos="0 0 -0.32">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="0 120"/>
          <geom name="left_shin_geom" type="cylinder" fromto="0 0 0  0 0 -0.2" size="0.025"/>
          <body name="left_wheel_hub" pos="0 0 -0.2">
            <joint name="left_wheel" type="hinge" axis="0 1 0" limited="false"/>
            <geom name="left_wheel_disc" type="cylinder" size="0.12 0.01" quat="0.7071 0.7071 0 0"
                  friction="1.5 0.01 0.005" rgba="0.67 0.5 0.7 1"/>
            <site name="left_wheel_site" pos="0 0 0"/>
          </body>
        </body>
      </body>


      <body name="right_leg" pos="0 -0.12 -0.36">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-50 50"/>
        <geom name="right_thigh" type="cylinder" fromto="0 0 0  0 0 -0.3" size="0.03"/>
        <body name="right_shin" pos="0 0 -0.32">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="0 120"/>
          <geom name="right_shin_geom" type="cylinder" fromto="0 0 0  0 0 -0.2" size="0.025"/>
          <body name="right_wheel_hub" pos="0 0 -0.2">
            <joint name="right_wheel" type="hinge" axis="0 1 0" limited="false"/>
            <geom name="right_wheel_disc" type="cylinder" size="0.12 0.01" quat="0.7071 0.7071 0 0"
                  friction="1.5 0.01 0.005" rgba="0.67 0.5 0.7 1"/>
            <site name="right_wheel_site" pos="0 0 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>

    <motor joint="left_hip" gear="100"/>
    <motor joint="left_knee" gear="100"/>
    <motor joint="right_hip" gear="100"/>
    <motor joint="right_knee" gear="100"/>

    <velocity joint="left_wheel" gear="15"/>
    <velocity joint="right_wheel" gear="15"/>
  </actuator>
</mujoco>
