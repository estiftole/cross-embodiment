<mujoco model="green_wheeled_quadruped">

  <default>
    <geom rgba="0.45 0.7 0.5 1" density="1000"/>
    <joint damping="1.0" armature="0.01" limited="true"/>
    <motor gear="80"/>
  </default>

  <worldbody>
    <body name="torso" pos="0 0 0.85">
      <freejoint/>
      <geom name="torso_box" type="box" size="0.3 0.18 0.05"/>

      <body name="fl_leg" pos="0.22 0.20 0">
        <joint name="fl_hip" type="hinge" axis="0 1 0" range="-60 60"/>
        <geom name="fl_hip_cyl" type="cylinder" fromto="0 -0.03 0 0 0.06 0" size="0.05"/>
        <geom name="fl_thigh" type="capsule" fromto="0 0 0 -0.08 0 -0.3" size="0.025"/>
        <body name="fl_shin" pos="-0.08 0 -0.3">
          <joint name="fl_knee" type="hinge" axis="0 1 0" range="-120 0"/>
          <geom name="fl_shin_geom" type="capsule" fromto="0 0 0 0.08 0 -0.3" size="0.02"/>
          <body name="fl_wheel_hub" pos="0.08 0 -0.3">
            <joint name="fl_wheel" type="hinge" axis="0 1 0" limited="false"/>
            <geom name="fl_wheel_disc" type="cylinder" size="0.08 0.015" quat="0.7071 0.7071 0 0"
                  friction="1.5 0.01 0.005" rgba="0.45 0.7 0.5 1"/>
            <site name="fl_wheel_site" pos="0 0 0"/>
          </body>
        </body>
      </body>

      <body name="fr_leg" pos="0.22 -0.20 0">
        <joint name="fr_hip" type="hinge" axis="0 1 0" range="-60 60"/>
        <geom name="fr_hip_cyl" type="cylinder" fromto="0 0.03 0 0 -0.06 0" size="0.05"/>
        <geom name="fr_thigh" type="capsule" fromto="0 0 0 -0.08 0 -0.3" size="0.025"/>
        <body name="fr_shin" pos="-0.08 0 -0.3">
          <joint name="fr_knee" type="hinge" axis="0 1 0" range="-120 0"/>
          <geom name="fr_shin_geom" type="capsule" fromto="0 0 0 0.08 0 -0.3" size="0.02"/>
          <body name="fr_wheel_hub" pos="0.08 0 -0.3">
            <joint name="fr_wheel" type="hinge" axis="0 1 0" limited="false"/>
            <geom name="fr_wheel_disc" type="cylinder" size="0.08 0.015" quat="0.7071 0.7071 0 0"
                  friction="1.5 0.01 0.005" rgba="0.45 0.7 0.5 1"/>
            <site name="fr_wheel_site" pos="0 0 0"/>
          </body>
        </body>
      </body>

      <body name="bl_leg" pos="-0.22 0.20 0">
        <joint name="bl_hip" type="hinge" axis="0 1 0" range="-60 60"/>
        <geom name="bl_hip_cyl" type="cylinder" fromto="0 -0.03 0 0 0.06 0" size="0.05"/>
        <geom name="bl_thigh" type="capsule" fromto="0 0 0 -0.08 0 -0.3" size="0.025"/>
        <body name="bl_shin" pos="-0.08 0 -0.3">
          <joint name="bl_knee" type="hinge" axis="0 1 0" range="-120 0"/>
          <geom name="bl_shin_geom" type="capsule" fromto="0 0 0 0.08 0 -0.3" size="0.02"/>
          <body name="bl_wheel_hub" pos="0.08 0 -0.3">
            <joint name="bl_wheel" type="hinge" axis="0 1 0" limited="false"/>
            <geom name="bl_wheel_disc" type="cylinder" size="0.08 0.015" quat="0.7071 0.7071 0 0"
                  friction="1.5 0.01 0.005" rgba="0.45 0.7 0.5 1"/>
            <site name="bl_wheel_site" pos="0 0 0"/>
          </body>
        </body>
      </body>

      <body name="br_leg" pos="-0.22 -0.20 0">
        <joint name="br_hip" type="hinge" axis="0 1 0" range="-60 60"/>
        <geom name="br_hip_cyl" type="cylinder" fromto="0 0.03 0 0 -0.06 0" size="0.05"/>
        <geom name="br_thigh" type="capsule" fromto="0 0 0 -0.08 0 -0.3" size="0.025"/>
        <body name="br_shin" pos="-0.08 0 -0.3">
          <joint name="br_knee" type="hinge" axis="0 1 0" range="-120 0"/>
          <geom name="br_shin_geom" type="capsule" fromto="0 0 0 0.08 0 -0.3" size="0.02"/>
          <body name="br_wheel_hub" pos="0.08 0 -0.3">
            <joint name="br_wheel" type="hinge" axis="0 1 0" limited="false"/>
            <geom name="br_wheel_disc" type="cylinder" size="0.08 0.015" quat="0.7071 0.7071 0 0"
                  friction="1.5 0.01 0.005" rgba="0.45 0.7 0.5 1"/>
            <site name="br_wheel_site" pos="0 0 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="fl_hip" gear="80"/>
    <motor joint="fl_knee" gear="80"/>
    <motor joint="fr_hip" gear="80"/>
    <motor joint="fr_knee" gear="80"/>
    <motor joint="bl_hip" gear="80"/>
    <motor joint="bl_knee" gear="80"/>
    <motor joint="br_hip" gear="80"/>
    <motor joint="br_knee" gear="80"/>

    <velocity joint="fl_wheel" gear="20"/>
    <velocity joint="fr_wheel" gear="20"/>
    <velocity joint="bl_wheel" gear="20"/>
    <velocity joint="br_wheel" gear="20"/>
  </actuator>
</mujoco>
