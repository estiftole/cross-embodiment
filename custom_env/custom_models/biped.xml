<mujoco model="mauve_biped">
  <default>
    <geom rgba="0.62 0.46 0.46 1" density="1000" friction="1 0.005 0.0001"/>
    <joint damping="1.0" armature="0.01" limited="true"/>
  </default>

  <worldbody>
    <body name="torso" pos="0 0 2">
      <freejoint/>
      <geom name="torso_box" type="box" size="0.08 0.18 0.3"/>
      <geom name="pelvis_sphere" type="sphere" size="0.04" pos="0 0 -0.34"/>
      <body name="left_leg" pos="0 0.12 -0.34">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-70 45"/>
        <geom name="left_hip_hinge" type="cylinder" fromto="0 -0.03 0 0 0.05 0" size="0.035"/>
        <geom name="left_thigh" type="cylinder" fromto="0 0.03 0 0 0.03 -0.3" size="0.03"/>
        <body name="left_shin" pos="0 0.03 -0.32">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="0 120"/>
          <geom name="left_shin_geom" type="cylinder" fromto="0 0 0 0 0 -0.6" size="0.025"/>
          <body name="left_foot" pos="0 0 -0.6">
             <geom name="left_foot_box" type="box" size="0.12 0.07 0.02" pos="0.06 0 -0.02"/>
             <site name="left_foot_site" pos="0.06 0 -0.02"/>
          </body>
        </body>
      </body>
      <body name="right_leg" pos="0 -0.12 -0.34">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-70 45"/>
        <geom name="right_hip_hinge" type="cylinder" fromto="0 0.03 0 0 -0.05 0" size="0.035"/>
        <geom name="right_thigh" type="cylinder" fromto="0 -0.03 0 0 -0.03 -0.3" size="0.03"/>
        <body name="right_shin" pos="0 -0.03 -0.32">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="0 120"/>
          <geom name="right_shin_geom" type="cylinder" fromto="0 0 0 0 0 -0.6" size="0.025"/>
          <body name="right_foot" pos="0 0 -0.6">
             <geom name="right_foot_box" type="box" size="0.12 0.07 0.02" pos="0.06 0 -0.02"/>
             <site name="right_foot_site" pos="0.06 0 -0.02"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="left_hip" gear="100"/>
    <motor joint="left_knee" gear="100"/>
    <motor joint="right_hip" gear="100"/>
    <motor joint="right_knee" gear="100"/>
  </actuator>
</mujoco>
